package LightCore.Win;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 2}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'LightSaber - Windows-only core library'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  Rtl,
  LightCore;

contains
  LightCore.Win.Download in 'LightCore.Win.Download.pas',
  LightCore.Win.Registry in 'LightCore.Win.Registry.pas',
  LightCore.Win.EnvironmentVar in 'LightCore.Win.EnvironmentVar.pas',
  LightCore.Win.Sound in 'LightCore.Win.Sound.pas',
  LightCore.Win.SystemPermissions in 'LightCore.Win.SystemPermissions.pas',
  LightCore.Win.WinVersionApi in 'LightCore.Win.WinVersionApi.pas';

end.

