package LightVcl.Common;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 2}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'LightSaber - Common'}
{$LIBSUFFIX AUTO}
{$IMPLICITBUILD ON}

requires
  rtl,
  vclimg,
  vcl,
  vclX,
  vclWinx,
  vclSmp,
  LightExternal,
  LightCore,
  LightCore.Win;

contains
  FormAsyncMessage in 'FormAsyncMessage.pas',
  LightVcl.Common.CenterControl in 'LightVcl.Common.CenterControl.pas',
  LightVcl.Common.Clipboard in 'LightVcl.Common.Clipboard.pas',
  LightVcl.Common.CpuMonitor in 'LightVcl.Common.CpuMonitor.pas',
  LightVcl.Common.CursorGuard in 'LightVcl.Common.CursorGuard.pas',
  LightVcl.Common.Debugger in 'LightVcl.Common.Debugger.pas',
  LightVcl.Common.Dialogs in 'LightVcl.Common.Dialogs.pas',
  LightVcl.Common.EllipsisText in 'LightVcl.Common.EllipsisText.pas',
  LightVcl.Common.ExecuteProc in 'LightVcl.Common.ExecuteProc.pas',
  LightVcl.Common.ExecuteShell in 'LightVcl.Common.ExecuteShell.pas',
  LightVcl.Common.INIFile in 'LightVcl.Common.INIFile.pas',
  LightVcl.Common.IO in 'LightVcl.Common.IO.pas',
  LightVcl.Common.KeybShortcuts in 'LightVcl.Common.KeybShortcuts.pas',
  LightVcl.Common.LogFilter in 'LightVcl.Common.LogFilter.pas',
  LightVcl.Common.LogViewer in 'LightVcl.Common.LogViewer.pas',
  LightVcl.Common.MemoInputBox in 'LightVcl.Common.MemoInputBox.pas',
  LightVcl.Common.MutexSingleInstance in 'LightVcl.Common.MutexSingleInstance.pas',
  LightVcl.Common.PopUp in 'LightVcl.Common.PopUp.pas',
  LightVcl.Common.PowerUtils in 'LightVcl.Common.PowerUtils.pas',
  LightVcl.Common.Reports in 'LightVcl.Common.Reports.pas',
  LightVcl.Common.Shell in 'LightVcl.Common.Shell.pas',
  LightVcl.Common.System in 'LightVcl.Common.System.pas',
  LightVcl.Common.SystemSecurity in 'LightVcl.Common.SystemSecurity.pas',
  LightVcl.Common.SystemTime in 'LightVcl.Common.SystemTime.pas',
  LightVcl.Common.Translate in '..\LightVcl.Common.Translate.pas',
  LightVcl.Common.VclUtils in 'LightVcl.Common.VclUtils.pas',
  LightVcl.Common.Window in 'LightVcl.Common.Window.pas',
  LightVcl.Common.WindowMetrics in 'LightVcl.Common.WindowMetrics.pas',
  LightVcl.Common.WinVersion in 'LightVcl.Common.WinVersion.pas';

end.
